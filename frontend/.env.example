# Copia este archivo como `.env` para personalizar la conexión con los backends.
# Sin variables, la app funciona en modo demostración y la telemetría apunta
# al proxy de Vite (`/api` ➜ http://localhost:5000).

# ── Backend de misión (crew, alertas, bitácora) ────────────────────────────
# Vacío = datos simulados en memoria (modo demostración).
VITE_API_BASE_URL=

# ── Estación de telemetría (Flask + PostgreSQL, hardware ESP32) ────────────
# Por defecto `/api`: el proxy de Vite reenvía a API_PROXY_TARGET
# (por defecto http://localhost:5000, donde corre el servidor Flask).
# Para apuntar directo al Flask, por ejemplo: VITE_TELEMETRY_API_URL=http://192.168.1.50:5000
VITE_TELEMETRY_API_URL=/api
