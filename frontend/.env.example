# Copia este archivo como `.env` para conectar el frontend con el backend.
# Sin esta variable, la app corre en modo demostración con datos simulados.

# Base URL de la API del backend (por ejemplo, http://localhost:8000/api).
# En desarrollo se recomienda dejarla vacía y usar el proxy de Vite:
# el backend debe escuchar en API_PROXY_TARGET (por defecto http://localhost:8000)
# y Vite reenvía automáticamente `/api/*`.
VITE_API_BASE_URL=
